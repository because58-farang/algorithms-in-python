def solution(players, callings):
    rank = {player: i for i, player in enumerate(players)}
    # enumrate(players)로 i에0 player에 'mumu' 이런식으로 변수에 할당
    # player : i 구조로 players 전체 순회
    for call in callings:
        #rank[call] # 불린 선수의 순위
        #rank[call]-1 # 불린 선수의 바로 앞 순위
        #rank[call], rank[call]-1 = rank[call-1], rank[call]
        
        current_rank = rank[call]
        if current_rank == 0:
            continue
        front_player = current_rank-1
        
        players[current_rank], players[front_player] = players[front_player], players[current_rank]
        rank[call] -= 1
        rank[front_player] += 1
        
        
    return players























